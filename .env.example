# ============================================
# TaskFlow Docker Environment Configuration
# ============================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
# cp .env.example .env
#
# 운영 환경에서는 반드시 다음 항목을 변경하세요:
# - MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD
# - JWT_SECRET
# - CORS_ALLOWED_ORIGINS
# ============================================

# ============================================
# MySQL Database
# ============================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflow123

# ============================================
# JWT Authentication (필수 - 반드시 변경하세요!)
# ============================================
# Base64 인코딩된 256비트 이상의 시크릿 키
# 생성 예시: openssl rand -base64 32
JWT_SECRET=your-base64-encoded-secret-key-at-least-256-bits-long

# ============================================
# Server Ports (선택)
# ============================================
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ============================================
# CORS Settings (중요!)
# ============================================
# FRONTEND_PORT 변경 시 반드시 이 값도 함께 변경하세요!
# 예: FRONTEND_PORT=4000 → CORS_ALLOWED_ORIGINS=http://localhost:4000
# 여러 origin은 쉼표로 구분
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Cookie Settings (선택)
# ============================================
# HTTPS 사용 시 true로 설정
COOKIE_SECURE=false

# ============================================
# Timezone
# ============================================
TZ=Asia/Seoul

# ============================================
# User Management Mode
# ============================================
# internal: 기본 사용자 관리 (내부 DB)
# external: 외부 DB 연동 (인사 시스템 등)
USER_MANAGEMENT_MODE=internal

# ============================================
# External DB Settings (USER_MANAGEMENT_MODE=external 시 필수)
# ============================================
# 외부 DB 연결 정보
# EXTERNAL_DB_URL=jdbc:mysql://external-db:3306/hr_system
# EXTERNAL_DB_USERNAME=readonly_user
# EXTERNAL_DB_PASSWORD=readonly_password

# 외부 DB 테이블/뷰 이름 (기본값 사용 가능)
# EXTERNAL_USER_TABLE=VW_TASKFLOW_USER
# EXTERNAL_DEPARTMENT_TABLE=VW_TASKFLOW_DEPARTMENT

# ============================================
# File Storage Settings (선택)
# ============================================
# 스토리지 타입: LOCAL, SFTP, NAS, S3
FILE_STORAGE_TYPE=LOCAL

# LOCAL 스토리지 설정
FILE_LOCAL_PATH=/app/uploads

# SFTP 스토리지 설정 (FILE_STORAGE_TYPE=SFTP 시 필수)
# SFTP_HOST=sftp.example.com
# SFTP_PORT=22
# SFTP_USERNAME=sftpuser
# SFTP_PASSWORD=sftppassword
# SFTP_PRIVATE_KEY_PATH=/path/to/private/key
# SFTP_PRIVATE_KEY_PASSPHRASE=
# SFTP_BASE_PATH=/data/uploads
# SFTP_CONNECTION_TIMEOUT=30000
# SFTP_CHANNEL_TIMEOUT=60000
# SFTP_STRICT_HOST_KEY_CHECKING=false
# SFTP_KNOWN_HOSTS_PATH=
# SFTP_POOL_SIZE=5
# SFTP_KEEP_ALIVE_INTERVAL=30000

# 파일 크기 제한
FILE_MAX_SIZE=10MB

# ============================================
# JVM Settings (선택 - 백엔드 성능 튜닝)
# ============================================
# 메모리 및 GC 설정
# 서버 사양에 따라 조정 (권장: 물리 메모리의 50~70%)
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ============================================
# MySQL Performance (선택 - DB 성능 튜닝)
# ============================================
# InnoDB 버퍼 풀 크기 (권장: 물리 메모리의 50~80%)
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
# 최대 연결 수
MYSQL_MAX_CONNECTIONS=200

# ============================================
# Logging Settings (선택)
# ============================================
# 로그 레벨: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
