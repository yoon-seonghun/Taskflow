# ============================================
# TaskFlow Docker Environment Configuration
# ============================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
# cp .env.example .env

# ============================================
# MySQL Database
# ============================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflow123

# ============================================
# JWT Authentication (필수 - 반드시 변경하세요!)
# ============================================
# Base64 인코딩된 256비트 이상의 시크릿 키
# 생성 예시: openssl rand -base64 32
JWT_SECRET=bG9jYWwtZGV2LWp3dC1zZWNyZXQta2V5LW11c3QtYmUtYXQtbGVhc3QtMjU2LWJpdHMtbG9uZy1mb3ItaHMyNTY=

# ============================================
# Server Ports (선택)
# ============================================
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ============================================
# CORS Settings (중요!)
# ============================================
# FRONTEND_PORT 변경 시 반드시 이 값도 함께 변경하세요!
# 예: FRONTEND_PORT=4000 → CORS_ALLOWED_ORIGINS=http://localhost:4000
# 여러 origin은 쉼표로 구분
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Cookie Settings (선택)
# ============================================
# HTTPS 사용 시 true로 설정
COOKIE_SECURE=false

# ============================================
# Timezone
# ============================================
TZ=Asia/Seoul

# ============================================
# 사용자 관리 모드 (선택)
# ============================================
# internal: 기본 관리 모드 (사용자/부서 CRUD 가능)
# external: 외부 DB 연동 모드 (읽기 전용)
USER_MANAGEMENT_MODE=internal

# ============================================
# 외부 DB 연결 정보 (external 모드 시 필수)
# ============================================
# 외부 DB에 사용자/부서 VIEW 필요
# VIEW 생성 방법: docs/external-db-setup.md 참고
EXTERNAL_DB_URL=jdbc:mysql://192.168.10.55:3306/dash_board?useSSL=false&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull
EXTERNAL_DB_USERNAME=dashusr
EXTERNAL_DB_PASSWORD="Sns!@9833"

# 외부 DB 테이블/뷰 이름 (필요시 변경)
EXTERNAL_USER_TABLE=VW_TASKFLOW_USER
EXTERNAL_DEPARTMENT_TABLE=VW_TASKFLOW_DEPARTMENT
