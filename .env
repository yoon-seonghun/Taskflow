# ============================================
# TaskFlow Docker Environment Configuration
# ============================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
# cp .env.example .env

# ============================================
# MySQL Database
# ============================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflow123

# ============================================
# JWT Authentication (필수 - 반드시 변경하세요!)
# ============================================
# Base64 인코딩된 256비트 이상의 시크릿 키
# 생성 예시: openssl rand -base64 32
JWT_SECRET=bG9jYWwtZGV2LWp3dC1zZWNyZXQta2V5LW11c3QtYmUtYXQtbGVhc3QtMjU2LWJpdHMtbG9uZy1mb3ItaHMyNTY=

# ============================================
# Server Ports (선택)
# ============================================
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ============================================
# CORS Settings (중요!)
# ============================================
# FRONTEND_PORT 변경 시 반드시 이 값도 함께 변경하세요!
# 예: FRONTEND_PORT=4000 → CORS_ALLOWED_ORIGINS=http://localhost:4000
# 여러 origin은 쉼표로 구분
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Cookie Settings (선택)
# ============================================
# HTTPS 사용 시 true로 설정
COOKIE_SECURE=false

# ============================================
# Timezone
# ============================================
TZ=Asia/Seoul

# ============================================
# 사용자 관리 모드 (선택)
# ============================================
# internal: 기본 관리 모드 (사용자/부서 CRUD 가능)
# external: 외부 DB 연동 모드 (읽기 전용)
USER_MANAGEMENT_MODE=external

# ============================================
# 외부 DB 연결 정보 (external 모드 시 필수)
# ============================================
# 외부 DB에 사용자/부서 VIEW 필요
# VIEW 생성 방법: docs/external-db-setup.md 참고
EXTERNAL_DB_URL=jdbc:mysql://192.168.10.55:3306/dash_board?useSSL=false&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull
EXTERNAL_DB_USERNAME=dashusr
EXTERNAL_DB_PASSWORD="Sns!@9833"

# 외부 DB 테이블/뷰 이름 (필요시 변경)
EXTERNAL_USER_TABLE=VW_TASKFLOW_USER
EXTERNAL_DEPARTMENT_TABLE=VW_TASKFLOW_DEPARTMENT
EXTERNAL_POSITION_TABLE=VW_TASKFLOW_POSITION

# ============================================
# File Storage Settings (선택)
# ============================================
# 스토리지 타입: LOCAL, SFTP, NAS, S3
FILE_STORAGE_TYPE=SFTP

# LOCAL 스토리지 설정
FILE_LOCAL_PATH=/app/uploads

# SFTP 스토리지 설정 (FILE_STORAGE_TYPE=SFTP 시 필수)
SFTP_HOST=192.168.10.45
SFTP_PORT=22
SFTP_USERNAME=taskflow
SFTP_PASSWORD="Qzmp10@9!"
SFTP_PRIVATE_KEY_PATH=
# SFTP 접속 후 최초 이동할 디렉토리 (홈 디렉토리와 다를 경우 설정)
SFTP_HOME_PATH=/Taskflow
SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_BASE_PATH=uploads
SFTP_CONNECTION_TIMEOUT=30000
SFTP_CHANNEL_TIMEOUT=60000
SFTP_STRICT_HOST_KEY_CHECKING=false
SFTP_KNOWN_HOSTS_PATH=
SFTP_POOL_SIZE=5
SFTP_KEEP_ALIVE_INTERVAL=30000

# 파일 크기 제한
FILE_MAX_SIZE=100MB

# ============================================
# JVM Settings (선택 - 백엔드 성능 튜닝)
# ============================================
# 메모리 및 GC 설정
# 서버 사양에 따라 조정 (권장: 물리 메모리의 50~70%)
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ============================================
# MySQL Performance (선택 - DB 성능 튜닝)
# ============================================
# InnoDB 버퍼 풀 크기 (권장: 물리 메모리의 50~80%)
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
# 최대 연결 수
MYSQL_MAX_CONNECTIONS=200

# ============================================
# Logging Settings (선택)
# ============================================
# 로그 레벨: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
