<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.taskflow.mapper.external.ExternalUserMapper">

    <!-- 사용자 ResultMap -->
    <!-- VIEW 기본 컬럼: USER_ID, USERNAME, PASSWORD, NAME, EMAIL, DEPARTMENT_CODE, DEPARTMENT_NAME, USE_YN, LAST_LOGIN_AT, CREATED_AT, CREATED_BY, UPDATED_AT, UPDATED_BY -->
    <!-- 선택적 컬럼 (외부 뷰에 없을 수 있음): POSITION_CODE, POSITION_NAME, POSITION_SORT_ORDER, HEAD_YN, ROLE -->
    <resultMap id="UserResultMap" type="com.taskflow.domain.User">
        <id property="userId" column="USER_ID"/>
        <result property="username" column="USERNAME"/>
        <result property="password" column="PASSWORD"/>
        <result property="name" column="NAME"/>
        <result property="email" column="EMAIL"/>
        <result property="departmentCode" column="DEPARTMENT_CODE"/>
        <result property="departmentName" column="DEPARTMENT_NAME"/>
        <result property="positionCode" column="POSITION_CODE"/>
        <result property="positionName" column="POSITION_NAME"/>
        <result property="positionSortOrder" column="POSITION_SORT_ORDER"/>
        <result property="role" column="ROLE"/>
        <result property="headYn" column="HEAD_YN"/>
        <result property="useYn" column="USE_YN"/>
        <result property="lastLoginAt" column="LAST_LOGIN_AT"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="createdBy" column="CREATED_BY"/>
        <result property="updatedAt" column="UPDATED_AT"/>
        <result property="updatedBy" column="UPDATED_BY"/>
    </resultMap>

    <!-- 공통 SQL 조각: VIEW에서 직접 DEPARTMENT_CODE, DEPARTMENT_NAME 제공 (조인 불필요) -->
    <!-- VIEW에 컬럼이 있으면 사용, 없거나 NULL이면 기본값 적용 (COALESCE) -->
    <sql id="selectUser">
        SELECT
            USER_ID,
            USERNAME,
            PASSWORD,
            NAME,
            EMAIL,
            DEPARTMENT_CODE,
            DEPARTMENT_NAME,
            POSITION_CODE,
            POSITION_NAME,
            COALESCE(SORT_ORDER, 999) AS POSITION_SORT_ORDER,
            COALESCE(UPPER(ROLE), 'USER') AS ROLE,
            COALESCE(HEAD_YN, 'N') AS HEAD_YN,
            USE_YN,
            LAST_LOGIN_AT,
            CREATED_AT,
            CREATED_BY,
            UPDATED_AT,
            UPDATED_BY
        FROM ${userTable}
    </sql>

    <!-- ID로 조회 -->
    <select id="findById" resultMap="UserResultMap">
        <include refid="selectUser"/>
        WHERE USER_ID = #{userId}
    </select>

    <!-- 로그인 아이디로 조회 -->
    <select id="findByUsername" resultMap="UserResultMap">
        <include refid="selectUser"/>
        WHERE USERNAME = #{username}
    </select>

    <!-- 사용자 목록 조회 -->
    <select id="findAll" resultMap="UserResultMap">
        <include refid="selectUser"/>
        <where>
            <if test="request.keyword != null and request.keyword != ''">
                AND (
                    NAME LIKE CONCAT('%', #{request.keyword}, '%')
                    OR USERNAME LIKE CONCAT('%', #{request.keyword}, '%')
                    OR EMAIL LIKE CONCAT('%', #{request.keyword}, '%')
                )
            </if>
            <if test="request.departmentCode != null and request.departmentCode != ''">
                AND DEPARTMENT_CODE = #{request.departmentCode}
            </if>
            <if test="request.useYn != null and request.useYn != ''">
                AND USE_YN = #{request.useYn}
            </if>
        </where>
        ORDER BY NAME
        <if test="request.size != null and request.size > 0">
            LIMIT #{request.size} OFFSET #{request.offset}
        </if>
    </select>

    <!-- 총 개수 조회 -->
    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM ${userTable}
        <where>
            <if test="request.keyword != null and request.keyword != ''">
                AND (
                    NAME LIKE CONCAT('%', #{request.keyword}, '%')
                    OR USERNAME LIKE CONCAT('%', #{request.keyword}, '%')
                    OR EMAIL LIKE CONCAT('%', #{request.keyword}, '%')
                )
            </if>
            <if test="request.departmentCode != null and request.departmentCode != ''">
                AND DEPARTMENT_CODE = #{request.departmentCode}
            </if>
            <if test="request.useYn != null and request.useYn != ''">
                AND USE_YN = #{request.useYn}
            </if>
        </where>
    </select>

    <!-- 부서별 사용자 목록 조회 -->
    <select id="findByDepartmentCode" resultMap="UserResultMap">
        <include refid="selectUser"/>
        WHERE DEPARTMENT_CODE = #{departmentCode}
          AND USE_YN = 'Y'
        ORDER BY NAME
    </select>

    <!-- 아이디 중복 확인 -->
    <select id="existsByUsername" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM ${userTable}
            WHERE USERNAME = #{username}
        )
    </select>

    <!-- 전체 활성 사용자 목록 조회 (동기화용) -->
    <select id="findAllActive" resultMap="UserResultMap">
        <include refid="selectUser"/>
        WHERE USE_YN = 'Y'
        ORDER BY USERNAME
    </select>

</mapper>
