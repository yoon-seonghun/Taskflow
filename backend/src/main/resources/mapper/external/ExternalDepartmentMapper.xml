<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.taskflow.mapper.external.ExternalDepartmentMapper">

    <!-- 부서 ResultMap -->
    <!-- VIEW 컬럼: DEPARTMENT_ID, DEPARTMENT_CODE, DEPARTMENT_NAME, PARENT_CODE, SORT_ORDER, USE_YN, CREATED_AT, CREATED_BY, UPDATED_AT, UPDATED_BY -->
    <resultMap id="DepartmentResultMap" type="com.taskflow.domain.Department">
        <id property="departmentId" column="DEPARTMENT_ID"/>
        <result property="departmentCode" column="DEPARTMENT_CODE"/>
        <result property="departmentName" column="DEPARTMENT_NAME"/>
        <result property="parentCode" column="PARENT_CODE"/>
        <result property="sortOrder" column="SORT_ORDER"/>
        <result property="useYn" column="USE_YN"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="createdBy" column="CREATED_BY"/>
        <result property="updatedAt" column="UPDATED_AT"/>
        <result property="updatedBy" column="UPDATED_BY"/>
    </resultMap>

    <!-- ID로 조회 -->
    <select id="findById" resultMap="DepartmentResultMap">
        SELECT *
        FROM ${departmentTable}
        WHERE DEPARTMENT_ID = #{departmentId}
    </select>

    <!-- 부서 코드로 조회 -->
    <select id="findByCode" resultMap="DepartmentResultMap">
        SELECT *
        FROM ${departmentTable}
        WHERE DEPARTMENT_CODE = #{departmentCode}
    </select>

    <!-- 전체 부서 목록 조회 (평면 구조) -->
    <select id="findAllFlat" resultMap="DepartmentResultMap">
        SELECT *
        FROM ${departmentTable}
        <where>
            <if test="useYn != null and useYn != ''">
                AND USE_YN = #{useYn}
            </if>
        </where>
        ORDER BY SORT_ORDER, DEPARTMENT_NAME
    </select>

    <!-- 최상위 부서 목록 조회 -->
    <select id="findRootDepartments" resultMap="DepartmentResultMap">
        SELECT *
        FROM ${departmentTable}
        WHERE PARENT_CODE IS NULL OR PARENT_CODE = ''
        <if test="useYn != null and useYn != ''">
            AND USE_YN = #{useYn}
        </if>
        ORDER BY SORT_ORDER, DEPARTMENT_NAME
    </select>

    <!-- 특정 부서의 하위 부서 목록 조회 (parentId 기반) -->
    <select id="findChildren" resultMap="DepartmentResultMap">
        SELECT *
        FROM ${departmentTable}
        WHERE PARENT_CODE = (SELECT DEPARTMENT_CODE FROM ${departmentTable} WHERE DEPARTMENT_ID = #{parentId})
          AND USE_YN = 'Y'
        ORDER BY SORT_ORDER, DEPARTMENT_NAME
    </select>

    <!-- 특정 부서의 하위 부서 목록 조회 (parentCode 기반) -->
    <select id="findByParentCode" resultMap="DepartmentResultMap">
        SELECT *
        FROM ${departmentTable}
        WHERE PARENT_CODE = #{parentCode}
          AND USE_YN = 'Y'
        ORDER BY SORT_ORDER, DEPARTMENT_NAME
    </select>

    <!-- 부서 코드 중복 확인 -->
    <select id="existsByCode" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM ${departmentTable}
            WHERE DEPARTMENT_CODE = #{departmentCode}
        )
    </select>

</mapper>
