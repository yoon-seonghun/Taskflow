<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.taskflow.mapper.external.ExternalPositionMapper">

    <!-- 직급 ResultMap -->
    <!-- VIEW 컬럼(소문자): position_id, position_code, position_name, sort_order, use_yn, created_at, created_by, updated_at, updated_by -->
    <resultMap id="PositionResultMap" type="com.taskflow.domain.Position">
        <id property="positionId" column="position_id"/>
        <result property="positionCode" column="position_code"/>
        <result property="positionName" column="position_name"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="useYn" column="use_yn"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>

    <!-- 공통 SELECT 컬럼 (VIEW 소문자 컬럼명 사용) -->
    <sql id="selectColumns">
        position_id,
        position_code,
        position_name,
        sort_order,
        use_yn,
        created_at,
        created_by,
        updated_at,
        updated_by
    </sql>

    <!-- ID로 조회 -->
    <select id="findById" resultMap="PositionResultMap">
        SELECT <include refid="selectColumns"/>
        FROM ${positionTable}
        WHERE position_id = #{positionId}
    </select>

    <!-- 직급 코드로 조회 -->
    <select id="findByCode" resultMap="PositionResultMap">
        SELECT <include refid="selectColumns"/>
        FROM ${positionTable}
        WHERE position_code = #{positionCode}
    </select>

    <!-- 전체 직급 목록 조회 -->
    <select id="findAll" resultMap="PositionResultMap">
        SELECT <include refid="selectColumns"/>
        FROM ${positionTable}
        <where>
            <if test="useYn != null and useYn != ''">
                AND use_yn = #{useYn}
            </if>
        </where>
        ORDER BY sort_order, position_name
    </select>

    <!-- 직급 코드 존재 확인 -->
    <select id="existsByCode" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM ${positionTable}
            WHERE position_code = #{positionCode}
        )
    </select>

    <!-- 전체 활성 직급 목록 조회 (동기화용) -->
    <select id="findAllActive" resultMap="PositionResultMap">
        SELECT <include refid="selectColumns"/>
        FROM ${positionTable}
        WHERE use_yn = 'Y'
        ORDER BY sort_order, position_name
    </select>

</mapper>
