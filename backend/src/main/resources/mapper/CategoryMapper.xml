<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.taskflow.mapper.CategoryMapper">

    <!-- ============================================= -->
    <!-- Result Map -->
    <!-- ============================================= -->

    <resultMap id="CategoryResultMap" type="com.taskflow.domain.Category">
        <id property="categoryId" column="CATEGORY_ID"/>
        <result property="categoryName" column="CATEGORY_NAME"/>
        <result property="color" column="COLOR"/>
        <result property="sortOrder" column="SORT_ORDER"/>
        <result property="useYn" column="USE_YN"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="createdBy" column="CREATED_BY"/>
        <result property="updatedAt" column="UPDATED_AT"/>
        <result property="updatedBy" column="UPDATED_BY"/>
    </resultMap>

    <!-- ============================================= -->
    <!-- 공통 SQL 조각 -->
    <!-- ============================================= -->

    <sql id="selectCategory">
        SELECT
            c.CATEGORY_ID,
            c.CATEGORY_NAME,
            c.COLOR,
            c.SORT_ORDER,
            c.USE_YN,
            c.CREATED_AT,
            c.CREATED_BY,
            c.UPDATED_AT,
            c.UPDATED_BY
        FROM TB_CATEGORY c
    </sql>

    <!-- ============================================= -->
    <!-- 조회 -->
    <!-- ============================================= -->

    <!-- 카테고리 ID로 조회 -->
    <select id="findById" resultMap="CategoryResultMap">
        <include refid="selectCategory"/>
        WHERE c.CATEGORY_ID = #{categoryId}
    </select>

    <!-- 전체 카테고리 목록 조회 (활성만) -->
    <select id="findAll" resultMap="CategoryResultMap">
        <include refid="selectCategory"/>
        WHERE c.USE_YN = 'Y'
        ORDER BY c.SORT_ORDER, c.CATEGORY_NAME
    </select>

    <!-- 전체 카테고리 목록 조회 (삭제 포함) -->
    <select id="findAllIncludingDeleted" resultMap="CategoryResultMap">
        <include refid="selectCategory"/>
        <where>
            <if test="useYn != null and useYn != ''">
                c.USE_YN = #{useYn}
            </if>
        </where>
        ORDER BY c.USE_YN DESC, c.SORT_ORDER, c.CATEGORY_NAME
    </select>

    <!-- 카테고리명으로 조회 -->
    <select id="findByName" resultMap="CategoryResultMap">
        <include refid="selectCategory"/>
        WHERE c.CATEGORY_NAME = #{categoryName}
    </select>

    <!-- 카테고리명 중복 확인 -->
    <select id="existsByName" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM TB_CATEGORY
            WHERE CATEGORY_NAME = #{categoryName}
              AND USE_YN = 'Y'
        )
    </select>

    <!-- 카테고리명 중복 확인 (자신 제외) -->
    <select id="existsByNameAndIdNot" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM TB_CATEGORY
            WHERE CATEGORY_NAME = #{categoryName}
              AND CATEGORY_ID != #{categoryId}
              AND USE_YN = 'Y'
        )
    </select>

    <!-- 최대 정렬 순서 조회 -->
    <select id="getMaxSortOrder" resultType="java.lang.Integer">
        SELECT COALESCE(MAX(SORT_ORDER), 0)
        FROM TB_CATEGORY
    </select>

    <!-- 카테고리 사용 여부 확인 (아이템에서 사용 중인지) -->
    <select id="hasItems" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM TB_ITEM
            WHERE CATEGORY_ID = #{categoryId}
        )
    </select>

    <!-- ============================================= -->
    <!-- 등록/수정/삭제 -->
    <!-- ============================================= -->

    <!-- 카테고리 등록 -->
    <insert id="insert" parameterType="com.taskflow.domain.Category" useGeneratedKeys="true" keyProperty="categoryId">
        INSERT INTO TB_CATEGORY (
            CATEGORY_NAME,
            COLOR,
            SORT_ORDER,
            USE_YN,
            CREATED_BY
        ) VALUES (
            #{categoryName},
            COALESCE(#{color}, '#6B7280'),
            #{sortOrder},
            COALESCE(#{useYn}, 'Y'),
            #{createdBy}
        )
    </insert>

    <!-- 카테고리 수정 -->
    <update id="update" parameterType="com.taskflow.domain.Category">
        UPDATE TB_CATEGORY
        SET
            CATEGORY_NAME = #{categoryName},
            COLOR = #{color},
            SORT_ORDER = #{sortOrder},
            USE_YN = #{useYn},
            UPDATED_BY = #{updatedBy},
            UPDATED_AT = CURRENT_TIMESTAMP
        WHERE CATEGORY_ID = #{categoryId}
    </update>

    <!-- 카테고리 논리 삭제 (USE_YN = 'N') -->
    <update id="softDelete">
        UPDATE TB_CATEGORY
        SET
            USE_YN = 'N',
            UPDATED_BY = #{updatedBy},
            UPDATED_AT = CURRENT_TIMESTAMP
        WHERE CATEGORY_ID = #{categoryId}
    </update>

    <!-- 카테고리 물리 삭제 (사용 금지 - 논리 삭제만 사용) -->
    <delete id="delete">
        DELETE FROM TB_CATEGORY
        WHERE CATEGORY_ID = #{categoryId}
    </delete>

</mapper>
