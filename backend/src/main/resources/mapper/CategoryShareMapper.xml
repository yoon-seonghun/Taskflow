<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.taskflow.mapper.CategoryShareMapper">

    <!-- ============================================= -->
    <!-- Result Map -->
    <!-- ============================================= -->

    <resultMap id="CategoryShareResultMap" type="com.taskflow.domain.CategoryShare">
        <id property="shareId" column="SHARE_ID"/>
        <result property="categoryId" column="CATEGORY_ID"/>
        <result property="shareType" column="SHARE_TYPE"/>
        <result property="shareTarget" column="SHARE_TARGET"/>
        <result property="shareTargetName" column="SHARE_TARGET_NAME"/>
        <result property="permission" column="PERMISSION"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="createdBy" column="CREATED_BY"/>
        <result property="updatedAt" column="UPDATED_AT"/>
        <result property="updatedBy" column="UPDATED_BY"/>
    </resultMap>

    <!-- ============================================= -->
    <!-- 공통 SQL 조각 -->
    <!-- ============================================= -->

    <sql id="selectCategoryShare">
        SELECT
            cs.SHARE_ID,
            cs.CATEGORY_ID,
            cs.SHARE_TYPE,
            cs.SHARE_TARGET,
            CASE
                WHEN cs.SHARE_TYPE = 'USER' THEN (SELECT NAME FROM TB_USER WHERE USERNAME = cs.SHARE_TARGET)
                WHEN cs.SHARE_TYPE = 'DEPARTMENT' THEN (SELECT DEPARTMENT_NAME FROM TB_DEPARTMENT WHERE DEPARTMENT_CODE = cs.SHARE_TARGET)
                ELSE cs.SHARE_TARGET
            END AS SHARE_TARGET_NAME,
            cs.PERMISSION,
            cs.CREATED_AT,
            cs.CREATED_BY,
            cs.UPDATED_AT,
            cs.UPDATED_BY
        FROM TB_CATEGORY_SHARE cs
    </sql>

    <!-- ============================================= -->
    <!-- 조회 -->
    <!-- ============================================= -->

    <!-- 공유 ID로 조회 -->
    <select id="findById" resultMap="CategoryShareResultMap">
        <include refid="selectCategoryShare"/>
        WHERE cs.SHARE_ID = #{shareId}
    </select>

    <!-- 카테고리별 공유 목록 조회 -->
    <select id="findByCategoryId" resultMap="CategoryShareResultMap">
        <include refid="selectCategoryShare"/>
        WHERE cs.CATEGORY_ID = #{categoryId}
        ORDER BY cs.SHARE_TYPE, cs.SHARE_TARGET
    </select>

    <!-- 특정 공유 대상으로 조회 -->
    <select id="findByTarget" resultMap="CategoryShareResultMap">
        <include refid="selectCategoryShare"/>
        WHERE cs.CATEGORY_ID = #{categoryId}
          AND cs.SHARE_TYPE = #{shareType}
          AND cs.SHARE_TARGET = #{shareTarget}
    </select>

    <!-- 공유 존재 여부 확인 -->
    <select id="exists" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM TB_CATEGORY_SHARE
            WHERE CATEGORY_ID = #{categoryId}
              AND SHARE_TYPE = #{shareType}
              AND SHARE_TARGET = #{shareTarget}
        )
    </select>

    <!-- ============================================= -->
    <!-- 등록/수정/삭제 -->
    <!-- ============================================= -->

    <!-- 공유 등록 -->
    <insert id="insert" parameterType="com.taskflow.domain.CategoryShare" useGeneratedKeys="true" keyProperty="shareId">
        INSERT INTO TB_CATEGORY_SHARE (
            CATEGORY_ID,
            SHARE_TYPE,
            SHARE_TARGET,
            PERMISSION,
            CREATED_BY
        ) VALUES (
            #{categoryId},
            #{shareType},
            #{shareTarget},
            COALESCE(#{permission}, 'READ'),
            #{createdBy}
        )
    </insert>

    <!-- 권한 수정 -->
    <update id="updatePermission">
        UPDATE TB_CATEGORY_SHARE
        SET
            PERMISSION = #{permission},
            UPDATED_BY = #{updatedBy},
            UPDATED_AT = CURRENT_TIMESTAMP
        WHERE SHARE_ID = #{shareId}
    </update>

    <!-- 공유 삭제 -->
    <delete id="delete">
        DELETE FROM TB_CATEGORY_SHARE
        WHERE SHARE_ID = #{shareId}
    </delete>

    <!-- 카테고리의 모든 공유 삭제 -->
    <delete id="deleteByCategoryId">
        DELETE FROM TB_CATEGORY_SHARE
        WHERE CATEGORY_ID = #{categoryId}
    </delete>

</mapper>
